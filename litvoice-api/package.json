{
  "name": "litvoice-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "daloy dev",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test tests/**/*.test.ts",
    "gen:openapi": "node --import tsx/esm scripts/dump-openapi.ts",
    "gen:client": "openapi-ts",
    "gen": "pnpm gen:openapi && pnpm gen:client",
    "audit": "pnpm audit --prod",
    "verify:lockfile": "node scripts/verify-lockfile-sources.mjs"
  },
  "dependencies": {
    "@daloyjs/core": "^0.37.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.1",
    "@types/node": "^25.7.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": ">=4.2.0"
    }
  }
}
